{
  "name": "steel-core",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "build": "npm run build:site && npm run audit:seo",
    "build:site": "react-router build && node scripts/finalize-static-build.mjs",
    "audit:seo": "node scripts/audit-seo-build.mjs",
    "lint": "eslint . --ignore-pattern build --ignore-pattern .react-router",
    "preview": "vite preview --outDir build/client"
  },
  "dependencies": {
    "@react-router/node": "7.14.0",
    "framer-motion": "^12.40.0",
    "isbot": "^5",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router": "7.14.0",
    "react-router-dom": "^7.14.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@react-router/dev": "7.14.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.27",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "postcss": "^8.5.8",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.19",
    "vite": "^8.0.1"
  }
